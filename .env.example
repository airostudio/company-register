# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/globalcorp?schema=public"

# Inngest — leave unset for local dev with `npm run inngest:dev`
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Registry mode: "mock" uses the built-in simulators (ASIC, US SoS, Companies House).
REGISTRY_MODE=mock
# Multiplier applied to simulated registry processing delays (1 = realistic-ish, 0.1 = fast demo)
MOCK_REGISTRY_SPEED=1
