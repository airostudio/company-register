# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/globalcorp?schema=public"

# Public base URL used in emails and payment redirects
APP_URL=http://localhost:3000

# Email: "resend" (set RESEND_API_KEY + EMAIL_FROM) or "log" (print to server log). Defaults to resend when a key is set.
EMAIL_DRIVER=log
RESEND_API_KEY=
EMAIL_FROM="GlobalCorp Hub <hello@example.com>"
# Development only: exposes /dev/mailbox with every email the app sent
DEV_MAILBOX=1

# Payments: Stripe Checkout when STRIPE_SECRET_KEY is set; otherwise orders are settled by a mock provider
# (refused in production unless ALLOW_MOCK_PAYMENTS=1). Webhook endpoint: /api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_MOCK_PAYMENTS=

# Comma-separated emails that get the ADMIN (ops console) role when they sign in
ADMIN_EMAILS=

# Background jobs: "inngest" (durable, recommended) or "inline" (runs in-process; status advances on poll)
JOB_RUNNER=inline

# Where generated documents are stored (local disk driver)
STORAGE_DIR=./storage

# Inngest — leave unset for local dev with `npm run inngest:dev`
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Registry mode: "mock" uses the built-in simulators; "live" uses real registers where an API exists
# and the ops console (assisted lodgement) where it doesn't. Override per jurisdiction: REGISTRY_MODE_UK=live
REGISTRY_MODE=mock
# Live name search: ABN Lookup (https://abr.business.gov.au/Tools/WebServices) and Companies House API
ABN_LOOKUP_GUID=
COMPANIES_HOUSE_API_KEY=
# Companies House XML Gateway electronic incorporation (validate with test credentials first)
CH_XML_GATEWAY_ENABLED=
CH_PRESENTER_ID=
CH_PRESENTER_AUTH=
CH_PRESENTER_EMAIL=
CH_GATEWAY_TEST=1
# Tax ID registration (EIN / ABN / UTR): "mock" simulator or "assisted" (ops console). Defaults to the
# registry mode per jurisdiction (live → assisted). Override: TAX_MODE=assisted or TAX_MODE_US_DE=mock
TAX_MODE=
# Rate limits (Postgres-backed, shared by all instances). Multiply every limit, e.g. 100 for local e2e runs; 0 disables.
RATE_LIMIT_SCALE=1
# Trust the first X-Forwarded-For hop for client IPs (set 0 if not behind a proxy you control)
TRUST_PROXY=1
# Legal templates: documents from templates without a recorded lawyer approval are watermarked
# "DRAFT · PENDING LEGAL REVIEW". "off" removes the watermark (local development only).
TEMPLATE_REVIEW_MODE=watermark
# Where ops task notifications go (defaults to ADMIN_EMAILS)
OPS_EMAIL=
# Multiplier applied to simulated registry processing delays (1 = realistic-ish, 0.1 = fast demo)
MOCK_REGISTRY_SPEED=1
# Probability (0-1) of a simulated transient gateway outage on submission
MOCK_REGISTRY_FAILURE_RATE=0
